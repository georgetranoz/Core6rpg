server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Gzip text-y responses
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

    # Long-cache hashed Vite assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Static files in /public (manifest, robots, sitemap, og images, etc.)
    # — short cache so updates propagate
    location ~* \.(webmanifest|json|xml|txt|png|jpg|jpeg|svg|ico|webp)$ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # SPA: fall back to index.html for any unknown route so React Router can handle it
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Don't cache the SPA shell — we want users to get fresh asset hashes
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    # Health check endpoint for Cloud Run liveness (optional but tidy)
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
